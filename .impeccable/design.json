      "html": "<div class=\"ds-row\"><span class=\"ds-badge ds-solid\"><svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" aria-hidden=\"true\"><path d=\"M3.85 8.62a4 4 0 0 1 4.78-4.77 4 4 0 0 1 6.74 0 4 4 0 0 1 4.78 4.78 4 4 0 0 1 0 6.74 4 4 0 0 1-4.77 4.78 4 4 0 0 1-6.75 0 4 4 0 0 1-4.78-4.77 4 4 0 0 1 0-6.76Z\"/><path d=\"m9 12 2 2 4-4\"/></svg>Verified student</span><span class=\"ds-badge ds-outline\">Coming next</span><span class=\"ds-badge ds-neutral\">React</span><span class=\"ds-badge ds-accent\">Matched</span></div>",
      "css": ":host{--navy:#14213d;--navy-deep:#0e1830;--cream:#f4ede0;--coral:#ff6b5b;--canvas:#f4ede0;--paper:#fbf8f2;--sunken:#ebe3d4;--ink:#14213d;--ink-soft:#2e3a55;--muted:#5b6478;--line:#ded4c2;--line-strong:#c9bda8;--action:#ff6b5b;--action-hover:#ff8577;--action-ink:#14213d;--accent:#b8392a;--accent-soft:#fbe2dc;--danger:#a3261b;--danger-soft:#f8ddd8} .ds-row{display:flex;gap:8px;flex-wrap:wrap;font-family:Geist,ui-sans-serif,system-ui,sans-serif;} .ds-badge{display:inline-flex;align-items:center;gap:4px;height:24px;padding:0 10px;border-radius:9999px;font-size:0.8125rem;font-weight:500;white-space:nowrap} .ds-solid{background:var(--ink);color:var(--canvas)} .ds-outline{border:1px solid var(--line);color:var(--muted)} .ds-neutral{background:var(--sunken);color:var(--ink-soft)} .ds-accent{background:var(--accent-soft);color:var(--accent)}"
