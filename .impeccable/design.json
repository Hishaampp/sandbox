      "css": ":host{--navy:#14213d;--navy-deep:#0e1830;--cream:#f4ede0;--coral:#ff6b5b;--canvas:#f4ede0;--paper:#fbf8f2;--sunken:#ebe3d4;--ink:#14213d;--ink-soft:#2e3a55;--muted:#5b6478;--line:#ded4c2;--line-strong:#c9bda8;--action:#ff6b5b;--action-hover:#ff8577;--action-ink:#14213d;--accent:#b8392a;--accent-soft:#fbe2dc;--danger:#a3261b;--danger-soft:#f8ddd8} .ds-panel{font-family:Geist,ui-sans-serif,system-ui,sans-serif;background:var(--paper);border:1px solid var(--line);border-radius:12px;padding:20px;max-width:360px} .ds-cap{margin:0;font-size:0.8125rem;color:var(--muted)} .ds-title{margin:2px 0 0;font-size:1.375rem;line-height:1.875rem;font-weight:600;letter-spacing:-0.01em;color:var(--ink)} .ds-body{margin:8px 0 0;font-size:0.9375rem;line-height:1.5rem;color:var(--ink-soft)}"
