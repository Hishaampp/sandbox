      "description": "The one coral action per view; navy label on coral (5.7:1).",
      "html": "<button class=\"ds-btn-primary\">Continue with Google</button>",
      "css": ":host{--navy:#14213d;--navy-deep:#0e1830;--cream:#f4ede0;--coral:#ff6b5b;--canvas:#f4ede0;--paper:#fbf8f2;--sunken:#ebe3d4;--ink:#14213d;--ink-soft:#2e3a55;--muted:#5b6478;--line:#ded4c2;--line-strong:#c9bda8;--action:#ff6b5b;--action-hover:#ff8577;--action-ink:#14213d;--accent:#b8392a;--accent-soft:#fbe2dc;--danger:#a3261b;--danger-soft:#f8ddd8} .ds-btn-primary{display:inline-flex;align-items:center;justify-content:center;gap:8px;height:40px;padding:0 16px;border-radius:6px;font-weight:500;font-size:0.9375rem;line-height:1.5rem;font-family:Geist,ui-sans-serif,system-ui,sans-serif;transition:background-color 150ms cubic-bezier(0.16,1,0.3,1),transform 150ms;cursor:pointer;background:var(--action);color:var(--action-ink);border:none} .ds-btn-primary:hover{background:var(--action-hover)} .ds-btn-primary:focus-visible{outline:2px solid var(--accent,#b8392a);outline-offset:2px;} .ds-btn-primary:active{transform:translateY(1px)}"
