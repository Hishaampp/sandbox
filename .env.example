# Supabase (local: run `supabase status` to see these values)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only key that bypasses RLS: used only to write GitHub skills. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Used only by the Supabase CLI to configure OAuth locally (supabase/config.toml).
# Never prefix these with NEXT_PUBLIC_.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
SUPABASE_AUTH_EXTERNAL_GITHUB_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GITHUB_SECRET=
